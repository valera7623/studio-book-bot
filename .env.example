# Скопируйте в .env. BOT_TOKEN обязателен для python -m src.main.
# Для create_tables.py токен можно не задавать.
BOT_TOKEN=000000:your_token_here

# Username бота без @ (для QR и ссылок, если getMe недоступен).
BOT_USERNAME=Studio_book_bot

# Опционально: прокси до api.telegram.org (таймауты / IPv6 на РФ-VPS).
# Примеры: socks5://127.0.0.1:1080  http://user:pass@host:8080
# TELEGRAM_PROXY=

# Образ для docker-compose.prod.yml (GitHub Actions пишет сам).
# DOCKER_IMAGE=ghcr.io/valera7623/studio-book-bot:latest

# Админы платформы (саппорт продукта, не контент). JSON или через запятую.
ADMINS=[]
# Superadmin: /superadmin — кол-во и Telegram ID платных подписчиков.
# Пусто = те же ID, что в ADMINS.
# SUPERADMINS=[]

# SQLite (по умолчанию data/studio_book.db). ПДн только на хостинге в РФ.
# SQLITE_PATH=/app/data/studio_book.db

# Антиспам: сколько действий пользователя разрешено за окно THROTTLE_TTL секунд
# THROTTLE_RATE_LIMIT=8
# THROTTLE_TTL=3

# FSM: Redis в проде (docker-compose.prod.yml). Локально можно оставить false.
# USE_REDIS=false
# REDIS_URL=redis://localhost:6379/0

# Логи
# LOG_LEVEL=INFO
# LOG_FILE=bot.log

# --- Оплата: ЮKassa (предпочтительно) или Prodamus. Секреты не в git. ---
# Отдельный магазин под https://studiobook.com.ru — не shopId agentops/gameforge.
# Кабинет: список сервисов → Добавить магазин → на сайте → studiobook.com.ru
# HTTP-уведомления: https://studiobook.com.ru/yookassa/webhook  (событие payment.succeeded)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# PAYMENT_PROVIDER=auto
#
# Запасной контур Prodamus (если ЮKassa ещё не одобрена):
# URL уведомления: https://studiobook.com.ru/prodamus/webhook
# PRODAMUS_SECRET=
# PRODAMUS_SHOP_ID=
# PRODAMUS_PAYFORM_URL=
# HOLD_TTL_MINUTES=20
# REMINDER_HOURS=24
# REMINDER_2H_HOURS=2
# PLUS_RESOURCE_LIMIT=6

# HTTP: лендинг, webhook Prodamus, iCal. 0 — выключить.
# HTTP_PORT=8088
# PUBLIC_BASE_URL=https://studiobook.com.ru
#
# HMAC подписки iCal (не BOT_TOKEN: смена токена не должна ломать календари).
# Если пусто — секрет пишется в data/.ical_secret (chmod 600). Старые URL
# с HMAC от BOT_TOKEN продолжают приниматься.
# ICAL_FEED_SECRET=
#
# Вторая копия SQLite-бэкапа (другой диск/VPS в РФ). 14 файлов, как локально.
# В docker: смонтируйте каталог и укажите путь внутри контейнера, например /offsite.
# BACKUP_OFFSITE_DIR=

# --- Неделя 3: тарифы владельца студии ---
# FREE_RESOURCE_LIMIT=1
# FREE_BOOKINGS_PER_MONTH=30
# TARIFF_STARTER_RUB=490
# TARIFF_PLUS_RUB=990

# Версия документа согласия на обработку ПДн (data/legal/consent_pdn.md)
# CONSENT_PDN_VERSION=1
